---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTABox from '../../components/CTABox.astro';
import { projeler } from '../../data/projeler';
import { musteriIfadeleri } from '../../data/referanslar';

export function getStaticPaths() {
  return projeler.map((p) => ({
    params: { slug: p.slug },
    props: { proje: p },
  }));
}

const { proje } = Astro.props;
const related = projeler.filter((p) => proje.relatedSlugs.includes(p.slug));
const canonical = `https://www.toremzemin.com/projelerimiz/${proje.slug}/`;

// Müşteri görüşü — projenin testimonialSlug'ı eşleşiyorsa otomatik bağla
const testimonial = proje.testimonialSlug
  ? musteriIfadeleri.find((t) => t.firmaSlug === proje.testimonialSlug)
  : undefined;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: proje.title,
  description: proje.desc,
  image: `https://www.toremzemin.com${proje.heroImage}`,
  author: {
    '@type': 'Organization',
    name: 'Torem Zemin Mühendislik',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Torem Zemin Mühendislik',
    url: 'https://www.toremzemin.com',
  },
};
---

<BaseLayout
  title={`${proje.title} | Torem Zemin Projelerimiz`}
  description={proje.desc}
  canonical={canonical}
  schema={schema}
>
  <!-- HERO -->
  <section class="proje-hero">
    <div class="proje-hero__bg" style={`background-image:url('${proje.heroImage}')`} aria-hidden="true"></div>
    <div class="proje-hero__overlay" aria-hidden="true"></div>
    <div class="container proje-hero__inner">
      <span class="proje-hero__cat">{proje.category}</span>
      <h1>{proje.title}</h1>
      <div class="proje-hero__meta">
        <span>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" width="14" height="14"><path d="M8 2a4 4 0 100 8A4 4 0 008 2zM8 14s-6-4-6-7a6 6 0 1112 0c0 3-6 7-6 7z"/></svg>
          {proje.location}
        </span>
        <span>{proje.year}</span>
        <span>{proje.client}</span>
      </div>
    </div>
    <div class="proje-hero__wave" aria-hidden="true">
      <svg viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,30 C360,60 720,0 1080,30 C1260,45 1380,40 1440,35 L1440,60 L0,60 Z" fill="var(--color-bg)" />
      </svg>
    </div>
  </section>

  <Breadcrumb items={[
    { label: 'Projelerimiz', href: '/projelerimiz/' },
    { label: proje.title },
  ]} />

  <!-- DETAY İÇERİK -->
  <section class="section">
    <div class="container proje-content-grid">

      <!-- Sol: Ana içerik -->
      <div class="proje-main">
        <div class="proje-block">
          <h2>Proje Özeti</h2>
          <p>{proje.summary}</p>
        </div>

        <!-- 🆕 ŞANTİYE VERİLERİ — sayısal vurgu -->
        {proje.santiyeVerileri && proje.santiyeVerileri.length > 0 && (
          <div class="proje-block">
            <h2>Şantiye Verileri</h2>
            <div class="santiye-grid">
              {proje.santiyeVerileri.map((v) => (
                <div class="santiye-stat">
                  <span class="santiye-stat__num">{v.v}</span>
                  <span class="santiye-stat__lbl">{v.l}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <div class="proje-block">
          <h2>Uygulama Yaklaşımı</h2>
          <p>{proje.approach}</p>
        </div>

        <!-- 🆕 SAHA FOTOĞRAF GALERİSİ -->
        {proje.galeri && proje.galeri.length > 0 && (
          <div class="proje-block">
            <h2>Saha Fotoğrafları</h2>
            <div class="proje-galeri">
              {proje.galeri.map((src, i) => {
                const base = src.replace(/\.(jpe?g|png)$/i, '');
                return (
                  <a href={src} class="galeri-item" target="_blank" rel="noopener">
                    <picture>
                      <source srcset={`${base}.avif`} type="image/avif" />
                      <source srcset={`${base}.webp`} type="image/webp" />
                      <img src={src} alt={`${proje.title} — saha fotoğrafı ${i + 1}`} loading="lazy" decoding="async" width="400" height="280" />
                    </picture>
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <div class="proje-block">
          <h2>Uygulanan Teknikler</h2>
          <div class="teknik-grid">
            {proje.teknikler.map((t) => (
              <a href={t.href} class="teknik-card">
                <span class="teknik-card__name">{t.name}</span>
                <span class="teknik-card__arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
          <p class="teknik-note">
            Uygulamalar ilgili sektör standartlarına (TS EN 1536, TS EN 1537, TS EN 12716, TS EN 14199, TBDY 2018) uygun olarak yürütülür.
          </p>
        </div>

        <!-- 🆕 SONUÇ & ETKİ -->
        {proje.sonucEtki && (
          <div class="proje-block proje-block--sonuc">
            <h2>Sonuç & Etki</h2>
            <p>{proje.sonucEtki}</p>
          </div>
        )}

        <!-- 🆕 MÜŞTERİ GÖRÜŞÜ — referanslar.ts'den otomatik bağlanır -->
        {testimonial && (
          <div class="proje-block">
            <h2>Müşteri Görüşü</h2>
            <article class="proje-testimonial" itemscope itemtype="https://schema.org/Review">
              <meta itemprop="itemReviewed" content="Torem Zemin Mühendislik" />
              <span class="proje-testimonial__mark" aria-hidden="true">&ldquo;</span>
              {testimonial.vurgu && (
                <p class="proje-testimonial__vurgu" itemprop="reviewBody">{testimonial.vurgu}</p>
              )}
              <p class="proje-testimonial__metin">{testimonial.metin}</p>
              <footer class="proje-testimonial__footer" itemprop="author" itemscope itemtype="https://schema.org/Person">
                {testimonial.logoBase && (
                  <picture class="proje-testimonial__logo">
                    <source srcset={`${testimonial.logoBase}.avif`} type="image/avif" />
                    <source srcset={`${testimonial.logoBase}.webp`} type="image/webp" />
                    <img src={`${testimonial.logoBase}.${testimonial.logoExt ?? 'jpg'}`} alt={`${testimonial.firma} logosu`} loading="lazy" decoding="async" width="64" height="32" />
                  </picture>
                )}
                <div class="proje-testimonial__kim">
                  <strong itemprop="name">{testimonial.ad}</strong>
                  <span class="proje-testimonial__unvan">
                    <span itemprop="jobTitle">{testimonial.unvan}</span>
                    <span aria-hidden="true">·</span>
                    <span itemprop="worksFor">{testimonial.firma}</span>
                  </span>
                </div>
              </footer>
            </article>
          </div>
        )}
      </div>

      <!-- Sağ: Sidebar -->
      <aside class="proje-sidebar">
        <div class="sidebar-card">
          <h3>Proje Bilgileri</h3>
          <ul class="sidebar-list">
            <li><span class="sidebar-list__lbl">Müşteri</span><span>{proje.client}</span></li>
            <li><span class="sidebar-list__lbl">Konum</span><span>{proje.location}</span></li>
            <li><span class="sidebar-list__lbl">Yıl</span><span>{proje.year}</span></li>
            <li><span class="sidebar-list__lbl">Kapsam</span><span>{proje.category}</span></li>
          </ul>
        </div>

        <div class="sidebar-cta">
          <p>Benzer bir projeniz mi var?</p>
          <a href="/iletisim/" class="btn btn--primary" style="width:100%;text-align:center;">Ücretsiz Keşif Raporu Alın</a>
          <a href="tel:+905316594636" class="btn btn--outline" style="width:100%;text-align:center;margin-top:0.75rem;">+90 531 659 46 36</a>
        </div>
      </aside>

    </div>
  </section>

  <!-- İLGİLİ PROJELER -->
  {related.length > 0 && (
    <section class="section related-section">
      <div class="container">
        <h2 class="related-title">İlgili Projeler</h2>
        <div class="related-grid">
          {related.map((r) => (
            <a href={`/projelerimiz/${r.slug}/`} class="related-card">
              <div class="related-card__img">
                <img src={r.image} alt={r.title} loading="lazy" width="400" height="260" />
                <span class="related-card__cat">{r.category}</span>
              </div>
              <div class="related-card__body">
                <h3>{r.title}</h3>
                <p>{r.location} · {r.year}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="section container">
    <CTABox title="Projenizi Birlikte Tasarlayalım" />
  </div>
</BaseLayout>

<style>
/* Hero */
.proje-hero {
  position:relative; margin-top:-110px;
  padding-block:calc(var(--s-20) + 110px) calc(var(--s-16) + 60px);
  color:var(--color-white); overflow:hidden;
}
.proje-hero__bg {
  position:absolute; inset:0;
  background-size:cover; background-position:center;
  z-index:0;
}
.proje-hero__overlay {
  position:absolute; inset:0;
  background:linear-gradient(135deg, rgba(0,21,48,0.88) 0%, rgba(0,33,71,0.75) 100%);
  z-index:1;
}
.proje-hero__inner { position:relative; z-index:2; max-width:760px; }
.proje-hero__cat {
  display:inline-block; background:var(--color-highlight); color:var(--color-primary);
  font-size:var(--text-xs); font-weight:700; text-transform:uppercase; letter-spacing:.08em;
  padding:.3rem .9rem; border-radius:999px; margin-bottom:var(--s-4);
}
.proje-hero h1 { color:white; font-size:var(--text-5xl); margin-bottom:var(--s-4); line-height:1.1; font-family: var(--font-serif); font-weight: 700; letter-spacing: -0.02em; }
.proje-hero__meta { display:flex; gap:var(--s-5); flex-wrap:wrap; color:rgba(255,255,255,.9); font-size:var(--text-sm); font-weight: 500; }
.proje-hero__meta span { display:inline-flex; align-items:center; gap:var(--s-1); }
.proje-hero__wave { position:absolute; bottom:0; left:0; right:0; height:60px; z-index:3; line-height:0; }
.proje-hero__wave svg { width:100%; height:100%; }

/* İçerik grid */
.proje-content-grid { display:grid; grid-template-columns:1fr 340px; gap:var(--s-12); align-items:start; }
.proje-main { display:flex; flex-direction:column; gap:var(--s-10); }
.proje-block h2 { font-size:var(--text-2xl); color:var(--color-primary); margin-bottom:var(--s-4); padding-bottom:var(--s-3); border-bottom:2px solid var(--color-border); display:inline-block; font-family:var(--font-serif); font-weight:700; }
.proje-block p { color:var(--color-text); line-height:1.8; font-size:var(--text-base); }

/* 🆕 Şantiye Verileri — sayısal stat blokları */
.santiye-grid {
  display:grid; grid-template-columns:repeat(auto-fit, minmax(140px, 1fr)); gap:var(--s-3);
}
.santiye-stat {
  display:flex; flex-direction:column; gap:4px;
  padding:var(--s-4) var(--s-3);
  background:var(--color-bg); border:1px solid var(--color-border);
  border-left:3px solid var(--color-highlight);
  border-radius:var(--r-sm);
  text-align:center;
}
.santiye-stat__num {
  font-family:var(--font-mono); font-size:var(--text-2xl); font-weight:700;
  color:var(--color-primary); line-height:1.1;
}
.santiye-stat__lbl {
  font-size:var(--text-xs); font-weight:600;
  color:var(--color-text-muted); text-transform:uppercase; letter-spacing:.06em;
  line-height:1.4;
}

/* 🆕 Saha Fotoğraf Galerisi */
.proje-galeri {
  display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:var(--s-3);
}
.galeri-item {
  display:block; aspect-ratio:4/3; overflow:hidden;
  border-radius:var(--r-md); border:1px solid var(--color-border);
  transition:transform var(--t-base), box-shadow var(--t-base);
}
.galeri-item:hover {
  transform:translateY(-2px);
  box-shadow:var(--shadow-md);
}
.galeri-item picture { display:block; width:100%; height:100%; }
.galeri-item img {
  width:100%; height:100%; object-fit:cover;
  transition:transform var(--t-slow);
}
.galeri-item:hover img { transform:scale(1.05); }

/* 🆕 Sonuç & Etki bloğu — vurgu */
.proje-block--sonuc {
  background:linear-gradient(135deg, rgba(212,175,55,.08) 0%, rgba(212,175,55,.02) 100%);
  border-left:4px solid var(--color-highlight);
  padding:var(--s-5) var(--s-6);
  border-radius:0 var(--r-md) var(--r-md) 0;
}
.proje-block--sonuc h2 {
  border-bottom-color:var(--color-highlight);
}

/* 🆕 Müşteri Görüşü — kompakt testimonial */
.proje-testimonial {
  position:relative;
  background:var(--color-white);
  border:1px solid var(--color-border);
  border-radius:var(--r-lg);
  padding:var(--s-6);
}
.proje-testimonial__mark {
  position:absolute; top:8px; right:18px;
  font-family:var(--font-serif); font-size:64px; line-height:1;
  color:var(--color-highlight); opacity:.22;
  pointer-events:none;
}
.proje-testimonial__vurgu {
  font-family:var(--font-serif); font-size:var(--text-xl); font-weight:500;
  color:var(--color-primary); line-height:1.4;
  margin:0 0 var(--s-3) 0;
}
.proje-testimonial__metin {
  font-size:var(--text-base); color:var(--color-text); line-height:1.7;
  margin:0;
}
.proje-testimonial__footer {
  display:flex; align-items:center; gap:var(--s-4);
  margin-top:var(--s-4); padding-top:var(--s-4);
  border-top:1px solid var(--color-border);
}
.proje-testimonial__logo {
  flex-shrink:0; width:48px; height:48px; border-radius:var(--r-sm);
  background:var(--color-bg); border:1px solid var(--color-border);
  display:flex; align-items:center; justify-content:center;
  mix-blend-mode:multiply;
}
.proje-testimonial__logo img { max-width:40px; max-height:40px; object-fit:contain; }
.proje-testimonial__kim { display:flex; flex-direction:column; gap:2px; }
.proje-testimonial__kim strong { color:var(--color-primary); font-weight:700; font-size:var(--text-base); }
.proje-testimonial__unvan { font-size:var(--text-sm); color:var(--color-text-muted); }

/* Teknik kartlar */
.teknik-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(220px, 1fr)); gap:var(--s-3); margin-bottom:var(--s-4); }
.teknik-card {
  display:flex; align-items:center; justify-content:space-between;
  padding:var(--s-4) var(--s-5); background:var(--color-white);
  border:1px solid var(--color-border); border-radius:var(--r-lg);
  color:var(--color-primary); text-decoration:none; font-weight:600;
  transition:border-color var(--t-fast), transform var(--t-fast), box-shadow var(--t-fast);
}
.teknik-card:hover { border-color:var(--color-highlight); transform:translateY(-2px); box-shadow:var(--shadow-md); }
.teknik-card__name { font-size:var(--text-sm); }
.teknik-card__arrow { color:var(--color-highlight); font-size:1.1rem; }
.teknik-note { font-size:var(--text-sm); color:var(--color-text-muted); font-style:italic; margin-top:var(--s-3); }

/* Sidebar */
.proje-sidebar { position:sticky; top:calc(var(--s-16) + var(--s-4)); display:flex; flex-direction:column; gap:var(--s-6); }
.sidebar-card { background:var(--color-white); border:1px solid var(--color-border); border-radius:var(--r-xl); padding:var(--s-6); }
.sidebar-card h3 { font-size:var(--text-lg); color:var(--color-primary); margin-bottom:var(--s-5); }
.sidebar-list { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:var(--s-3); }
.sidebar-list li { display:flex; flex-direction:column; gap:var(--s-1); padding-bottom:var(--s-3); border-bottom:1px solid var(--color-border); }
.sidebar-list li:last-child { border-bottom:none; padding-bottom:0; }
.sidebar-list__lbl { font-size:var(--text-xs); font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--color-text-muted); }
.sidebar-list span:not(.sidebar-list__lbl) { font-size:var(--text-sm); color:var(--color-text); font-weight:500; }
.sidebar-cta { background:var(--color-primary); border-radius:var(--r-xl); padding:var(--s-6); }
.sidebar-cta p { color:rgba(255,255,255,.85); font-size:var(--text-sm); margin-bottom:var(--s-4); }

/* İlgili projeler */
.related-section { background:var(--color-bg); }
.related-title { font-size:var(--text-3xl); color:var(--color-primary); margin-bottom:var(--s-8); font-family:var(--font-serif); font-weight:700; }
.related-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:var(--s-6); }
.related-card {
  text-decoration:none; color:inherit; background:var(--color-white); border-radius:var(--r-xl); overflow:hidden; border:1px solid var(--color-border);
  transition:transform var(--t-base), box-shadow var(--t-base), border-color var(--t-base); display:block; position:relative;
}
.related-card::before {
  content:''; position:absolute; inset:0 0 auto 0; height:4px;
  background:linear-gradient(90deg, var(--color-primary), var(--color-highlight));
  transform:scaleX(0); transform-origin:left; transition:transform 0.4s ease; z-index:10;
}
.related-card:hover { transform:translateY(-8px); box-shadow:var(--shadow-xl); border-color:transparent; }
.related-card:hover::before { transform:scaleX(1); }
.related-card__img { position:relative; aspect-ratio:3/2; overflow:hidden; }
.related-card__img img { width:100%; height:100%; object-fit:cover; transition:transform var(--t-slow); }
.related-card:hover .related-card__img img { transform:scale(1.04); }
.related-card__cat { position:absolute; top:var(--s-3); left:var(--s-3); background:var(--color-highlight); color:var(--color-primary); font-size:var(--text-xs); font-weight:700; padding:.2rem .7rem; border-radius:999px; }
.related-card__body { padding:var(--s-4); }
.related-card__body h3 { font-size:var(--text-base); font-weight:700; color:var(--color-primary); margin-bottom:var(--s-1); }
.related-card__body p { font-size:var(--text-xs); color:var(--color-text-muted); }

/* Responsive */
@media (max-width:1024px) { .proje-content-grid { grid-template-columns:1fr; } .proje-sidebar { position:static; } }
@media (max-width:768px) { .related-grid { grid-template-columns:1fr; } .teknik-grid { grid-template-columns:1fr; } }
@media (max-width: 560px) { .proje-hero h1 { font-size:var(--text-3xl); } }
</style>
